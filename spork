#!/bin/bash
# spork - a Scoop-style package manager for macOS that never needs admin rights.
#
# GUI apps go to ~/Applications, fonts to ~/Library/Fonts, command-line tools are
# linked into ~/.spork/bin (add that to $PATH with: eval "$(spork shellenv)").
#
# Only uses tools that ship with macOS: bash 3.2, curl, plutil (reads JSON),
# shasum, ditto, tar, hdiutil and pkgutil. git is optional.

set -o pipefail

# sysctl, pkgutil, diskutil and mount live in /usr/sbin and /sbin, which a
# minimal PATH may lack. Append them so the user's own tools still come first.
PATH=$PATH:/usr/bin:/bin:/usr/sbin:/sbin

SPORK_VERSION=0.1.0
SPORK_HOME=${SPORK_HOME:-$HOME/.spork}
SPORK_APPDIR=${SPORK_APPDIR:-$HOME/Applications}
SPORK_FONTDIR=${SPORK_FONTDIR:-$HOME/Library/Fonts}
BIN_DIR=$SPORK_HOME/bin
APPS_DIR=$SPORK_HOME/apps
DRAWERS_DIR=$SPORK_HOME/drawers
CACHE_DIR=$SPORK_HOME/cache
PERSIST_DIR=$SPORK_HOME/persist
MIRRORS_FILE=${SPORK_MIRRORS_FILE:-$SPORK_HOME/mirrors}
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

# Real CPU architecture, even when this shell runs under Rosetta.
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then ARCH=arm64; else ARCH=x86_64; fi
ARCH=${SPORK_ARCH:-$ARCH}

FORCE=
PURGE=

# ---------------------------------------------------------------- output

if [ -t 1 ]; then
  B=$'\033[1m' G=$'\033[32m' Y=$'\033[33m' R=$'\033[31m' C=$'\033[36m' D=$'\033[2m' N=$'\033[0m'
else
  B= G= Y= R= C= D= N=
fi
say()  { printf '%s==>%s %s\n' "$G$B" "$N" "$*"; }
note() { printf '%s    %s%s\n' "$D" "$*" "$N"; }
warn() { printf '%swarning:%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# ---------------------------------------------------------------- temp files

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/spork.XXXXXX") || die "cannot create a temp directory"
TMP_ROOT=$(cd "$TMP_ROOT" && pwd -P)
cleanup() {
  # Detach any disk image still mounted under our temp dir (e.g. after an error).
  mount | awk -v r="$TMP_ROOT" 'index($3, r) == 1 { print $3 }' | while IFS= read -r m; do
    hdiutil detach -force -quiet "$m" 2>/dev/null
  done
  rm -rf "$TMP_ROOT"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# ---------------------------------------------------------------- JSON (via plutil)

jget()  { plutil -extract "$2" raw -o - "$1" 2>/dev/null; }
jtype() { plutil -type "$2" "$1" 2>/dev/null; }
jhas()  { plutil -type "$2" "$1" >/dev/null 2>&1; }

# Print each item of a value that may be a string or an array of strings.
jlist() {
  local f=$1 k=$2 t n i=0
  t=$(jtype "$f" "$k") || return 0
  if [ "$t" = array ]; then
    n=$(jget "$f" "$k")
    while [ "$i" -lt "$n" ]; do jget "$f" "$k.$i"; i=$((i + 1)); done
  else
    jget "$f" "$k"
  fi
}

# Choose which build of a manifest to use; sets M_ARCH.
pick_arch() {
  local f=$1
  if jhas "$f" "architecture.$ARCH"; then M_ARCH=$ARCH
  elif jhas "$f" url; then M_ARCH=universal
  elif [ "$ARCH" = arm64 ] && jhas "$f" architecture.x86_64; then
    M_ARCH=x86_64
    warn "no Apple silicon build; using the Intel build (needs Rosetta 2)"
  else
    die "$(basename "$f" .json) is not available for $ARCH"
  fi
}

# Key path for a manifest field, preferring the architecture-specific value.
mkey() {
  local f=$1 k=$2
  if [ "$M_ARCH" != universal ] && jhas "$f" "architecture.$M_ARCH.$k"; then
    echo "architecture.$M_ARCH.$k"
  elif jhas "$f" "$k"; then
    echo "$k"
  else
    return 1
  fi
}
mget() { local k; k=$(mkey "$1" "$2") && jget "$1" "$k"; }

# Print "path<TAB>alias" for each command a manifest exposes.
# "bin" may be "path", ["path", ...] or [["path", "alias"], ...].
bin_entries() {
  local f=$1 k n i=0 p a
  k=$(mkey "$f" bin) || return 0
  if [ "$(jtype "$f" "$k")" != array ]; then
    p=$(jget "$f" "$k"); printf '%s\t%s\n' "$p" "$(basename "$p")"; return 0
  fi
  n=$(jget "$f" "$k")
  while [ "$i" -lt "$n" ]; do
    if [ "$(jtype "$f" "$k.$i")" = array ]; then
      p=$(jget "$f" "$k.$i.0"); a=$(jget "$f" "$k.$i.1")
    else
      p=$(jget "$f" "$k.$i"); a=$(basename "$p")
    fi
    printf '%s\t%s\n' "$p" "$a"
    i=$((i + 1))
  done
}

# ---------------------------------------------------------------- drawers & manifests

# Manifests sit in a drawer's "drawer/" folder, or at its top level.
manifest_dir() { if [ -d "$1/drawer" ]; then echo "$1/drawer"; else echo "$1"; fi; }

list_drawers() {
  [ -d "$DRAWERS_DIR/main" ] && echo main
  local d b
  for d in "$DRAWERS_DIR"/*; do
    [ -d "$d" ] || continue
    b=$(basename "$d"); [ "$b" = main ] || echo "$b"
  done
}

# Find a manifest. Accepts "name", "drawer/name", a path to a .json file or a URL.
# Sets M_NAME, M_FILE, M_DRAWER and M_SOURCE.
resolve() {
  local q=$1 b f
  M_SOURCE= M_FILE=
  case $q in
    http://*|https://*)
      M_NAME=$(basename "${q%%\?*}" .json); M_DRAWER=url; M_SOURCE=$q
      M_FILE=$TMP_ROOT/manifest-$M_NAME.json
      mcurl -fsSL -o "$M_FILE" "$q" || die "could not download manifest $(mirror_url "$q")" ;;
    *.json)
      [ -f "$q" ] || die "no such file: $q"
      M_NAME=$(basename "$q" .json); M_DRAWER=file
      M_FILE=$(cd "$(dirname "$q")" && pwd)/$(basename "$q"); M_SOURCE=$M_FILE ;;
    */*)
      b=${q%%/*}; M_NAME=${q#*/}; M_DRAWER=$b
      [ -d "$DRAWERS_DIR/$b" ] || die "no drawer named '$b' (see: spork drawer list)"
      M_FILE=$(manifest_dir "$DRAWERS_DIR/$b")/$M_NAME.json
      [ -f "$M_FILE" ] || die "no package '$M_NAME' in drawer '$b'" ;;
    *)
      M_NAME=$q
      for b in $(list_drawers); do
        f=$(manifest_dir "$DRAWERS_DIR/$b")/$q.json
        if [ -f "$f" ]; then M_FILE=$f; M_DRAWER=$b; break; fi
      done
      [ -n "$M_FILE" ] || die "couldn't find package '$q' (try: spork search $q)" ;;
  esac
  plutil -convert json -o /dev/null "$M_FILE" 2>/dev/null || die "invalid JSON in $M_FILE"
  jhas "$M_FILE" version || die "manifest has no \"version\": $M_FILE"
}

# ---------------------------------------------------------------- installed state

installed_version() {
  local l; l=$(readlink "$APPS_DIR/$1/current" 2>/dev/null) && echo "${l##*/}"
}
installed_list() {
  local d
  for d in "$APPS_DIR"/*; do [ -L "$d/current" ] && basename "$d"; done
}
receipt() { sed -n "s/^$2=//p" "$APPS_DIR/$1/current/.spork/info" 2>/dev/null; }

# Which package owns a command name in $BIN_DIR / an app path in $SPORK_APPDIR /
# a font path in $SPORK_FONTDIR.
owner_of() {
  local list=$1 item=$2 f
  for f in "$APPS_DIR"/*/"$list"; do
    [ -f "$f" ] && grep -qxF -- "$item" "$f" && { basename "$(dirname "$f")"; return 0; }
  done
  return 1
}
remove_app() {
  [ -x "$LSREGISTER" ] && "$LSREGISTER" -u "$1" >/dev/null 2>&1
  rm -rf "$1" && note "removed $1"
}
app_running() { pgrep -f "$1/Contents/MacOS/" >/dev/null 2>&1; }

# ---------------------------------------------------------------- mirrors
#
# The mirrors file holds URL rewrite rules, one per line: "<from-prefix> <to-prefix>".
# A URL starting with <from-prefix> is downloaded from <to-prefix> + the rest of
# the URL instead. When several rules match, the longest prefix wins.
# Lines starting with # are comments. Rules apply to curl downloads only;
# git drawers clone straight from their URL.

mirror_rules() {
  [ -f "$MIRRORS_FILE" ] && awk 'NF >= 2 && $1 !~ /^#/ { print $1 "\t" $2 }' "$MIRRORS_FILE"
}

mirror_url() {
  local url=$1 from to best= best_to=
  while IFS=$'\t' read -r from to; do
    [ -n "$from" ] || continue
    case $url in
      "$from"*) [ ${#from} -gt ${#best} ] && best=$from best_to=$to ;;
    esac
  done <<EOF
$(mirror_rules)
EOF
  if [ -n "$best" ]; then echo "$best_to${url#"$best"}"; else echo "$url"; fi
}

# ---------------------------------------------------------------- mirror logins
#
# Mirrors behind a login (Artifactory, Nexus, ...) get HTTP basic auth when the
# login keychain has an internet password for the mirror's host. Only URLs that a
# mirror rule rewrote get credentials, so nothing is sent to the original sites.
# The password never appears on a command line: curl reads it from stdin.
# SPORK_KEYCHAIN=0 turns this off.

url_host() { local h=${1#*://}; h=${h%%/*}; h=${h##*@}; echo "${h%%:*}"; }

# The account stored for a host. Reading it doesn't touch the password, so the
# keychain never asks for permission here.
keychain_account() {
  [ "${SPORK_KEYCHAIN:-1}" != 0 ] && [ -n "$1" ] || return 1
  command -v security >/dev/null 2>&1 || return 1
  security find-internet-password -s "$1" 2>/dev/null \
    | sed -n 's/^ *"acct"<blob>="\(.*\)"$/\1/p' | head -n 1 | grep .
}

# Sets CRED_USER and CRED_PASS for a host, or fails when the keychain has no
# login for it. Results are remembered so each host is looked up once per run.
KC_HOST= KC_USER= KC_PASS= KC_MISS=' '
mirror_creds() {
  local host=$1
  CRED_USER= CRED_PASS=
  [ -n "$host" ] || return 1
  case $KC_MISS in *" $host "*) return 1 ;; esac
  if [ "$host" != "$KC_HOST" ]; then
    KC_USER=$(keychain_account "$host") \
      && KC_PASS=$(security find-internet-password -s "$host" -a "$KC_USER" -w 2>/dev/null) \
      || { KC_MISS="$KC_MISS$host "; return 1; }
    KC_HOST=$host
  fi
  CRED_USER=$KC_USER CRED_PASS=$KC_PASS
}

# A curl config line holding the login, quoted for curl's config syntax.
curl_user_config() {
  # sed, because bash 3.2 mangles backslashes in ${s//...} replacements.
  printf 'user = "%s"\n' "$(printf '%s' "$1:$2" | sed 's/[\\"]/\\&/g')"
}

# curl through the mirror rules. The URL must be the last argument.
# --proxy-negotiate lets curl log in to a Kerberos (SPNEGO) proxy with the
# user's ticket; it does nothing when no proxy is set or the proxy doesn't ask.
mcurl() {
  local n=$# url real
  url=${!n}
  real=$(mirror_url "$url")
  set -- --proxy-negotiate "${@:1:$((n - 1))}" "$real"
  if [ "$real" != "$url" ] && mirror_creds "$(url_host "$real")"; then
    curl -K - "$@" <<<"$(curl_user_config "$CRED_USER" "$CRED_PASS")"
  else
    curl "$@"
  fi
}

# git for network calls. Like mcurl, it logs in to a Kerberos (SPNEGO) proxy
# with the user's ticket.
netgit() { git -c http.proxyAuthMethod=negotiate "$@"; }

# ---------------------------------------------------------------- download, verify, extract

fetch() {
  local url=$1 out=$2 progress=-sS real
  if [ -f "$out" ]; then note "using cached $(basename "$out")"; return 0; fi
  real=$(mirror_url "$url")
  say "Downloading $url"
  if [ "$real" != "$url" ]; then
    if mirror_creds "$(url_host "$real")"; then note "via mirror $real (as $CRED_USER)"
    else note "via mirror $real"; fi
  fi
  [ -t 2 ] && progress=--progress-bar
  mcurl -fL $progress --retry 3 --connect-timeout 20 -o "$out.part" "$url" \
    || { rm -f "$out.part"; die "download failed: $real"; }
  mv "$out.part" "$out"
}

# Hashes are "sha256:<hex>", "sha512:<hex>", "sha1:<hex>" or bare hex (sha256).
verify() {
  local file=$1 want=$2 algo=256 got
  case $want in sha1:*) algo=1;; sha512:*) algo=512;; esac
  want=$(printf %s "${want#*:}" | tr 'A-F' 'a-f')
  got=$(shasum -a "$algo" "$file" | awk '{ print $1 }')
  if [ "$got" != "$want" ]; then
    rm -f "$file"
    die "hash check failed for $(basename "$file")
    expected: $want
    got:      $got"
  fi
  note "hash ok"
}

extract_dmg() {
  local mnt=$TMP_ROOT/mnt-$RANDOM e
  mkdir -p "$mnt"
  # "echo Y" accepts the licence prompt some disk images show.
  # macOS 27 deprecates "hdiutil attach" in favour of "diskutil image attach".
  if diskutil image attach --help >/dev/null 2>&1; then
    echo Y | diskutil image attach --readOnly --nobrowse --mountPoint "$mnt" "$1" >/dev/null || return 1
  else
    echo Y | hdiutil attach -nobrowse -readonly -noautoopen -noverify -mountpoint "$mnt" "$1" >/dev/null || return 1
  fi
  for e in "$mnt"/*; do
    [ -L "$e" ] && continue          # e.g. the "Applications" shortcut
    [ -e "$e" ] || continue
    ditto "$e" "$2/$(basename "$e")" || { hdiutil detach -force -quiet "$mnt"; return 1; }
  done
  hdiutil detach -quiet "$mnt" || hdiutil detach -force -quiet "$mnt"
}

# Unpack a .pkg's payloads without running its installer scripts (no root needed).
extract_pkg() {
  local x=$TMP_ROOT/pkg-$RANDOM p
  pkgutil --expand-full "$1" "$x" >/dev/null || return 1
  while IFS= read -r p; do
    ditto "$p" "$2" || return 1
  done <<EOF
$(find "$x" -type d -name Payload -prune)
EOF
}

extract() {
  local file=$1 dest=$2 name=$3 lc
  lc=$(printf %s "$name" | tr '[:upper:]' '[:lower:]')
  mkdir -p "$dest"
  case $lc in
    *.zip) ditto -x -k "$file" "$dest" ;;
    *.tar|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.bz2|*.tbz|*.tbz2|*.tar.zst) tar -xf "$file" -C "$dest" ;;
    *.dmg) extract_dmg "$file" "$dest" ;;
    *.pkg) extract_pkg "$file" "$dest" ;;
    *.gz)  gunzip -c "$file" > "$dest/${name%.*}" && chmod +x "$dest/${name%.*}" ;;
    *)     cp "$file" "$dest/$name" && chmod +x "$dest/$name" ;;   # a plain binary
  esac || die "could not extract $name"
}

# Run an install/uninstall hook from the manifest. Hooks see $dir, $version,
# $appdir, $fontdir, $bindir, $arch and $persist_dir.
run_hook() {
  local f=$1 hook=$2 dir=$3 script
  script=$(jlist "$f" "$hook")
  [ -n "$script" ] || return 0
  note "running $hook"
  ( cd "$dir" && dir=$dir version=$(jget "$f" version) appdir=$SPORK_APPDIR fontdir=$SPORK_FONTDIR bindir=$BIN_DIR arch=$M_ARCH \
      persist_dir=$PERSIST_DIR/$(basename "$(dirname "$dir")") \
      bash -ec "export dir version appdir fontdir bindir arch persist_dir; $script" ) || die "$hook failed"
}

# ---------------------------------------------------------------- linking

unlink_bins() {
  local pkgdir=$APPS_DIR/$1 a
  [ -f "$pkgdir/.spork-bins" ] || return 0
  while IFS= read -r a; do
    [ -n "$a" ] && [ -L "$BIN_DIR/$a" ] && rm -f "$BIN_DIR/$a"
  done < "$pkgdir/.spork-bins"
  rm -f "$pkgdir/.spork-bins"
}

link_bins() {
  local name=$1 f=$2 pkgdir=$APPS_DIR/$1 p a target owner
  mkdir -p "$BIN_DIR"
  : > "$pkgdir/.spork-bins"
  while IFS=$'\t' read -r p a; do
    [ -n "$p" ] || continue
    if [ -e "$pkgdir/current/$p" ]; then
      target=$pkgdir/current/$p                       # survives version updates
    elif [ -e "$SPORK_APPDIR/$p" ]; then
      target=$SPORK_APPDIR/$p                         # a tool inside an installed .app
    else
      warn "$name: command '$p' not found in package; skipping"; continue
    fi
    if [ "$a" = spork ]; then warn "refusing to replace the 'spork' command"; continue; fi
    if [ -e "$BIN_DIR/$a" ] || [ -L "$BIN_DIR/$a" ]; then
      owner=$(owner_of .spork-bins "$a")
      if [ -z "$FORCE" ]; then
        warn "skipping '$a': already provided by ${owner:-another file in $BIN_DIR} (use --force to take it over)"
        continue
      fi
      rm -f "$BIN_DIR/$a"
      [ -n "$owner" ] && sed -i '' "/^$a\$/d" "$APPS_DIR/$owner/.spork-bins"
    fi
    chmod +x "$target" 2>/dev/null
    ln -s "$target" "$BIN_DIR/$a" && echo "$a" >> "$pkgdir/.spork-bins"
    note "linked $a"
  done <<EOF
$(bin_entries "$f")
EOF
}

# Move .app bundles into $SPORK_APPDIR; remove ones the previous version had
# but the new one doesn't.
install_apps() {
  local name=$1 f=$2 dir=$3 pkgdir=$APPS_DIR/$1 entry target owner new old
  new=$TMP_ROOT/apps-$name; : > "$new"
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    [ -e "$dir/$entry" ] || die "$name: app '$entry' not found in package"
    target=$SPORK_APPDIR/$(basename "$entry")
    owner=$(owner_of .spork-apps "$target")
    if [ -e "$target" ] && [ "$owner" != "$name" ] && [ -z "$FORCE" ]; then
      if [ -n "$owner" ]; then die "$target belongs to the package '$owner'. Use --force to replace it."
      else die "$target already exists and wasn't installed by spork. Use --force to replace it."; fi
    fi
    if [ -e "$target" ] && app_running "$target"; then
      die "$(basename "$target") is running. Quit it, then try again."
    fi
    mkdir -p "$SPORK_APPDIR"
    rm -rf "$target" && mv "$dir/$entry" "$target" || die "could not move $entry to $SPORK_APPDIR"
    [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$target" >/dev/null 2>&1
    echo "$target" >> "$new"
    note "installed $target"
  done <<EOF
$(k=$(mkey "$f" app) && jlist "$f" "$k")
EOF
  if [ -f "$pkgdir/.spork-apps" ]; then
    while IFS= read -r old; do
      grep -qxF -- "$old" "$new" || remove_app "$old"
    done < "$pkgdir/.spork-apps"
  fi
  mv "$new" "$pkgdir/.spork-apps"
}

# Print each package file a "font" entry matches, one per line. Entries are
# paths relative to the package folder and may use wildcards, e.g. "ttf/*.ttf".
font_files() {
  local dir=$1 entry=$2 m IFS=
  case "/$entry/" in
    */../*|*/./*) die "font '$entry' must be a plain path inside the package" ;;
  esac
  case $entry in /*) die "font '$entry' must be relative to the package folder" ;; esac
  shopt -s nullglob; m=("$dir"/$entry); shopt -u nullglob
  [ ${#m[@]} -gt 0 ] || die "font '$entry' not found in package"
  printf '%s\n' "${m[@]}"
}

# Move font files into $SPORK_FONTDIR, where macOS picks them up for this user;
# remove ones the previous version had but the new one doesn't. Everything is
# checked before anything is moved, so a conflict leaves the fonts as they were.
install_fonts() {
  local name=$1 f=$2 dir=$3 pkgdir=$APPS_DIR/$1 entry file target owner new old
  local list=$TMP_ROOT/fontlist-$1
  local -a files=() targets=()
  local i=0 n=0
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    font_files "$dir" "$entry" > "$list"            # not in $(...), so its errors stop the install
    while IFS= read -r file; do
      [ -f "$file" ] || die "$name: font '${file#"$dir"/}' is not a file"
      target=$SPORK_FONTDIR/$(basename "$file")
      case " ${targets[*]-} " in *" $target "*) die "$name: two fonts are named $(basename "$file")" ;; esac
      owner=$(owner_of .spork-fonts "$target")
      if [ -e "$target" ] && [ "$owner" != "$name" ] && [ -z "$FORCE" ]; then
        if [ -n "$owner" ]; then die "$target belongs to the package '$owner'. Use --force to replace it."
        else die "$target already exists and wasn't installed by spork. Use --force to replace it."; fi
      fi
      files[n]=$file; targets[n]=$target; n=$((n + 1))
    done < "$list"
  done <<EOF
$(k=$(mkey "$f" font) && jlist "$f" "$k")
EOF
  [ "$n" -gt 0 ] || { [ -f "$pkgdir/.spork-fonts" ] || return 0; }

  new=$TMP_ROOT/fonts-$name; : > "$new"
  [ "$n" -gt 0 ] && { mkdir -p "$SPORK_FONTDIR" || die "could not create $SPORK_FONTDIR"; }
  while [ "$i" -lt "$n" ]; do
    rm -f "${targets[i]}" && mv "${files[i]}" "${targets[i]}" || die "could not move ${files[i]#"$dir"/} to $SPORK_FONTDIR"
    echo "${targets[i]}" >> "$new"
    i=$((i + 1))
  done
  [ "$n" -gt 0 ] && note "installed $n font(s) in $SPORK_FONTDIR"
  if [ -f "$pkgdir/.spork-fonts" ]; then
    while IFS= read -r old; do
      [ -n "$old" ] && ! grep -qxF -- "$old" "$new" && rm -f "$old" && note "removed $old"
    done < "$pkgdir/.spork-fonts"
  fi
  if [ -s "$new" ]; then mv "$new" "$pkgdir/.spork-fonts"; else rm -f "$new" "$pkgdir/.spork-fonts"; fi
}

# ---------------------------------------------------------------- persisted user data

# Print "path<TAB>name" for each persist entry. "persist" may be "path",
# ["path", ...] or [["path", "name"], ...]; the name defaults to the path.
persist_entries() {
  local f=$1 k n i=0 p t
  k=$(mkey "$f" persist) || return 0
  if [ "$(jtype "$f" "$k")" != array ]; then
    p=$(jget "$f" "$k"); printf '%s\t%s\n' "$p" "$p"; return 0
  fi
  n=$(jget "$f" "$k")
  while [ "$i" -lt "$n" ]; do
    if [ "$(jtype "$f" "$k.$i")" = array ]; then
      p=$(jget "$f" "$k.$i.0"); t=$(jget "$f" "$k.$i.1")
    else
      p=$(jget "$f" "$k.$i"); t=$p
    fi
    printf '%s\t%s\n' "$p" "$t"
    i=$((i + 1))
  done
}

# Persist paths must stay inside the package and outside .app bundles, which
# are moved to ~/Applications and must not be modified.
check_persist_path() {
  case "/$1/" in
    //|*/../*|*/./*) die "persist path '$1' must be a plain path inside the package" ;;
  esac
  case $1 in
    /*) die "persist path '$1' must be relative to the package folder" ;;
    *.app|*.app/*) die "persist path '$1' is inside an app bundle; apps keep their data in ~/Library" ;;
  esac
}

# Replace each persisted path in the package with a link to the user's copy in
# $PERSIST_DIR/<pkg>/. The first install moves the shipped file or folder there
# (or creates an empty folder); later installs keep the user's copy.
link_persist() {
  local name=$1 f=$2 dir=$3 p t src keep
  while IFS=$'\t' read -r p t; do
    p=${p%/}; t=${t%/}
    [ -n "$p" ] || continue
    check_persist_path "$p"; check_persist_path "$t"
    src=$dir/$p; keep=$PERSIST_DIR/$name/$t
    if [ -e "$keep" ] || [ -L "$keep" ]; then
      rm -rf "$src"
    elif [ -e "$src" ]; then
      mkdir -p "$(dirname "$keep")" && mv "$src" "$keep" || die "could not move $p to $keep"
    else
      mkdir -p "$keep" || die "could not create $keep"
    fi
    mkdir -p "$(dirname "$src")" && ln -s "$keep" "$src" || die "could not link $p to $keep"
    note "persisted $p"
  done <<EOF
$(persist_entries "$f")
EOF
}

# ---------------------------------------------------------------- extra PATH folders

# Print the absolute folder for each "env_add_path" entry. Entries are relative
# to the package folder (through "current", so they survive updates), or start
# with $persist_dir for the package's saved-data folder. Run it in the current
# shell (not in $(...)) when a bad entry should stop the install.
resolve_paths() {
  local name=$1 f=$2 k p base rel
  k=$(mkey "$f" env_add_path) || return 0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case $p in
      '$persist_dir')   base=$PERSIST_DIR/$name; rel= ;;
      '$persist_dir/'*) base=$PERSIST_DIR/$name; rel=${p#\$persist_dir/} ;;
      *)                base=$APPS_DIR/$name/current; rel=$p ;;
    esac
    rel=${rel%/}; [ "$rel" = . ] && rel=
    case $rel in
      /*) die "env_add_path '$p' must be relative to the package folder or start with \$persist_dir" ;;
    esac
    case "/$rel/" in
      */../*|*/./*) die "env_add_path '$p' must stay inside the package" ;;
    esac
    echo "$base${rel:+/$rel}"
  done <<EOF
$(jlist "$f" "$k")
EOF
}

# ---------------------------------------------------------------- install / uninstall

do_install() {
  resolve "$1"
  local name=$M_NAME f=$M_FILE drawer=$M_DRAWER source=$M_SOURCE
  local ver pkgdir cur dep i url dl fname cached ed src x dir n
  local -a urls hashes
  ver=$(jget "$f" version)
  pkgdir=$APPS_DIR/$name
  cur=$(installed_version "$name")

  if [ "$cur" = "$ver" ] && [ -z "$FORCE" ]; then
    say "$name $ver is already installed"; return 0
  fi

  for dep in $(jlist "$f" depends); do
    [ -n "$(installed_version "${dep##*/}")" ] && continue
    say "Installing dependency $dep"
    ( FORCE= do_install "$dep" ) || die "could not install dependency $dep"
  done

  pick_arch "$f"
  local p t
  while IFS=$'\t' read -r p t; do                  # catch bad paths before downloading
    [ -n "$p" ] && check_persist_path "${p%/}" && check_persist_path "${t%/}"
  done <<EOF
$(persist_entries "$f")
EOF
  resolve_paths "$name" "$f" >/dev/null
  if [ -n "$cur" ]; then say "Updating $name $cur -> $ver ${D}[$drawer]$N"
  else say "Installing $name $ver ${D}[$drawer, $M_ARCH]$N"; fi

  n=0; while IFS= read -r url; do [ -n "$url" ] && urls[n]=$url && n=$((n + 1)); done <<EOF
$(k=$(mkey "$f" url) && jlist "$f" "$k")
EOF
  [ "$n" -gt 0 ] || die "$name: manifest has no url"
  i=0; while IFS= read -r url; do hashes[i]=$url; i=$((i + 1)); done <<EOF
$(k=$(mkey "$f" hash) && jlist "$f" "$k")
EOF

  mkdir -p "$pkgdir" "$CACHE_DIR"
  x=$TMP_ROOT/extract-$name; rm -rf "$x"; mkdir -p "$x"
  i=0
  while [ "$i" -lt "$n" ]; do
    url=${urls[i]}; dl=${url%%#*}
    case $url in
      *'#/'*) fname=${url##*#/} ;;                      # "url#/name" renames the download
      *)      fname=$(basename "${dl%%\?*}") ;;
    esac
    cached=$CACHE_DIR/$name#$ver#$fname
    fetch "$dl" "$cached"
    if [ -n "${hashes[i]}" ]; then verify "$cached" "${hashes[i]}"
    else warn "manifest has no hash for $fname; it was not verified"; fi
    extract "$cached" "$x" "$fname"
    i=$((i + 1))
  done

  ed=$(mget "$f" extract_dir); src=$x
  if [ -n "$ed" ]; then src=$x/$ed; [ -d "$src" ] || die "extract_dir '$ed' not found in the download"; fi
  xattr -dr com.apple.quarantine "$src" 2>/dev/null

  dir=$pkgdir/$ver
  [ "$cur" = "$ver" ] && unlink_bins "$name"      # reinstalling the same version
  rm -rf "$dir" && mv "$src" "$dir" || die "could not move files into $dir"

  run_hook "$f" pre_install "$dir"
  link_persist "$name" "$f" "$dir"
  install_apps "$name" "$f" "$dir"
  install_fonts "$name" "$f" "$dir"
  unlink_bins "$name"
  ln -sfn "$ver" "$pkgdir/current"
  link_bins "$name" "$f"
  resolve_paths "$name" "$f" > "$pkgdir/.spork-paths"
  [ -s "$pkgdir/.spork-paths" ] || rm -f "$pkgdir/.spork-paths"

  mkdir -p "$dir/.spork"
  cp "$f" "$dir/.spork/manifest.json"
  printf 'drawer=%s\nsource=%s\narch=%s\ninstalled=%s\n' \
    "$drawer" "$source" "$M_ARCH" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/.spork/info"

  run_hook "$f" post_install "$dir"

  # Keep only the new version.
  for old in "$pkgdir"/*; do
    [ -d "$old" ] && [ ! -L "$old" ] && [ "$old" != "$dir" ] && rm -rf "$old"
  done

  say "${B}$name $ver$N installed"
  if [ -f "$pkgdir/.spork-paths" ]; then
    local p missing=
    while IFS= read -r p; do
      note "adds $p to PATH"
      case ":$PATH:" in *":$p:"*) ;; *) missing=1 ;; esac
    done < "$pkgdir/.spork-paths"
    [ -n "$missing" ] && note "open a new terminal, or run: eval \"\$(spork shellenv)\""
  fi
  local notes; notes=$(k=$(mkey "$f" notes) && jlist "$f" "$k")
  [ -n "$notes" ] && printf '%sNotes:%s\n%s\n' "$C" "$N" "$(printf '%s\n' "$notes" | sed 's/^/    /')"
  return 0
}

do_uninstall() {
  local name=$1 pkgdir=$APPS_DIR/$1 a f
  if [ ! -d "$pkgdir" ]; then
    # --purge also clears data left behind by an earlier uninstall.
    if [ -n "$PURGE" ] && [ -d "$PERSIST_DIR/$name" ]; then
      rm -rf "$PERSIST_DIR/$name"; say "Deleted saved data of $name"; return 0
    fi
    die "$name is not installed"
  fi
  if [ -f "$pkgdir/.spork-apps" ] && [ -z "$FORCE" ]; then
    while IFS= read -r a; do
      app_running "$a" && die "$(basename "$a") is running. Quit it, then try again."
    done < "$pkgdir/.spork-apps"
  fi
  f=$pkgdir/current/.spork/manifest.json
  if [ -f "$f" ]; then M_ARCH=$(receipt "$name" arch); run_hook "$f" pre_uninstall "$pkgdir/current"; fi
  say "Uninstalling $name $(installed_version "$name")"
  unlink_bins "$name"
  if [ -f "$pkgdir/.spork-apps" ]; then
    while IFS= read -r a; do [ -n "$a" ] && remove_app "$a"; done < "$pkgdir/.spork-apps"
  fi
  if [ -f "$pkgdir/.spork-fonts" ]; then
    while IFS= read -r a; do [ -n "$a" ] && rm -f "$a"; done < "$pkgdir/.spork-fonts"
    note "removed $(grep -c . "$pkgdir/.spork-fonts") font(s) from $SPORK_FONTDIR"
  fi
  rm -rf "$pkgdir"
  if [ -d "$PERSIST_DIR/$name" ]; then
    if [ -n "$PURGE" ]; then rm -rf "$PERSIST_DIR/$name"; note "deleted saved data in $PERSIST_DIR/$name"
    else note "kept your data in $PERSIST_DIR/$name (spork uninstall --purge $name deletes it)"; fi
  fi
  say "$name uninstalled"
}

# Where an installed package's manifest comes from now.
source_of() {
  local name=$1 src drawer
  src=$(receipt "$name" source); drawer=$(receipt "$name" drawer)
  if [ -n "$src" ]; then echo "$src"
  elif [ -n "$drawer" ] && [ -f "$(manifest_dir "$DRAWERS_DIR/$drawer")/$name.json" ]; then echo "$drawer/$name"
  else echo "$name"; fi
}

# Print the latest available version, or nothing if it can't be found.
latest_version() {
  local q f
  q=$(source_of "$1")
  case $q in
    http*) f=$TMP_ROOT/latest-$1.json; mcurl -fsSL -o "$f" "$q" 2>/dev/null || return 1 ;;
    *.json) f=$q ;;
    */*) f=$(manifest_dir "$DRAWERS_DIR/${q%%/*}")/$1.json ;;
    *) for b in $(list_drawers); do f=$(manifest_dir "$DRAWERS_DIR/$b")/$1.json; [ -f "$f" ] && break; done ;;
  esac
  [ -f "$f" ] && jget "$f" version
}

# ---------------------------------------------------------------- drawer helpers

# The official drawers, which "spork drawer add <name>" knows without a URL.
known_drawer_url() {
  case $1 in
    main|apps|fonts) echo "https://github.com/spork-pm/$1" ;;
    *) return 1 ;;
  esac
}

has_git() {
  local g; g=$(command -v git) || return 1
  # /usr/bin/git is only a stub until the Command Line Tools are installed.
  [ "$g" != /usr/bin/git ] || xcode-select -p >/dev/null 2>&1
}

# Turn a GitHub repo URL into a tarball URL, for machines without git.
tarball_url() {
  case $1 in
    https://github.com/*)
      local p=${1#https://github.com/}; p=${p%.git}; p=${p%/}
      echo "https://codeload.github.com/$p/tar.gz/HEAD" ;;
    *.tar.gz|*.tgz) echo "$1" ;;
    *) return 1 ;;
  esac
}

fetch_drawer_tarball() {
  local url=$1 dest=$2 t tmp
  t=$(tarball_url "$url") || die "git isn't available and '$url' isn't a GitHub or .tar.gz URL"
  tmp=$TMP_ROOT/drawer-$RANDOM; mkdir -p "$tmp"
  mcurl -fsSL "$t" | tar -xzf - -C "$tmp" --strip-components 1 || die "could not download drawer from $(mirror_url "$t")"
  rm -rf "$dest" && mv "$tmp" "$dest" && echo "$url" > "$dest/.spork-source"
}

drawer_kind() {
  local d=$DRAWERS_DIR/$1
  if [ -L "$d" ]; then echo "link -> $(readlink "$d")"
  elif [ -d "$d/.git" ]; then echo "git $(git -C "$d" remote get-url origin 2>/dev/null)"
  elif [ -f "$d/.spork-source" ]; then echo "download $(cat "$d/.spork-source")"
  else echo local; fi
}

update_drawer() {
  local b=$1 d=$DRAWERS_DIR/$1
  if [ -L "$d" ]; then return 0
  elif [ -d "$d/.git" ]; then
    has_git || { warn "can't update '$b': git is not available"; return 0; }
    note "updating drawer $b"; netgit -C "$d" pull --ff-only -q || warn "could not update drawer $b"
  elif [ -f "$d/.spork-source" ]; then
    note "updating drawer $b"; ( fetch_drawer_tarball "$(cat "$d/.spork-source")" "$d" ) || warn "could not update drawer $b"
  fi
}

# Print "drawer/name<TAB>version" for each manifest in the given drawers. Reads
# the first "version" in each file with one awk call, so it stays fast on big drawers.
drawer_snapshot() {
  local b
  for b in "$@"; do
    awk -v b="$b" '
      FNR == 1 { seen = 0 }
      !seen && match($0, /"version"[ \t]*:[ \t]*"[^"]*"/) {
        v = substr($0, RSTART, RLENGTH); sub(/^"version"[ \t]*:[ \t]*"/, "", v); sub(/"$/, "", v)
        n = FILENAME; sub(/.*\//, "", n); sub(/\.json$/, "", n)
        print b "/" n "\t" v; seen = 1
      }' "$(manifest_dir "$DRAWERS_DIR/$b")"/*.json 2>/dev/null
  done
}

# Update drawers, then show packages they added and versions they changed.
update_drawers() {
  local before=$TMP_ROOT/drawers-before after=$TMP_ROOT/drawers-after b kind q a v desc name
  drawer_snapshot "$@" > "$before"
  for b in "$@"; do update_drawer "$b"; done
  drawer_snapshot "$@" > "$after"
  awk -F'\t' 'NR == FNR { old[$1] = $2; next }
    !($1 in old) { print "new\t" $1 "\t-\t" $2; next }
    old[$1] != $2 { print "upd\t" $1 "\t" old[$1] "\t" $2 }' "$before" "$after" > "$TMP_ROOT/drawers-diff"
  for kind in new upd; do
    grep -q "^$kind	" "$TMP_ROOT/drawers-diff" || continue
    if [ $kind = new ]; then say "New packages:"; else say "New versions:"; fi
    while IFS=$'\t' read -r _ q a v; do
      name=${q#*/}; b=${q%%/*}
      [ "$b" = main ] || name="$name ($b)"
      if [ $kind = new ]; then
        desc=$(jget "$(manifest_dir "$DRAWERS_DIR/$b")/${q#*/}.json" description)
        printf '    %-24s %s%s\n' "$name" "$G$v$N" "${desc:+  $D$desc$N}"
      else
        printf '    %-24s %s -> %s\n' "$name" "$a" "$G$v$N"
      fi
    done < <(grep "^$kind	" "$TMP_ROOT/drawers-diff" | sort -t$'\t' -k2)
  done
}

# ---------------------------------------------------------------- self-update

# spork's own files live in $SPORK_HOME/self, fetched like a drawer: a git clone
# of $SPORK_REPO, or a download with a .spork-source file when git is missing.
# $BIN_DIR/spork links to self/spork. A self that's a link (install.sh --link)
# is a developer checkout and is never updated.

SELF_DIR=$SPORK_HOME/self
SPORK_REPO=${SPORK_REPO:-https://github.com/spork-pm/spork}

self_valid() { [ -f "$1/spork" ] && bash -n "$1/spork" 2>/dev/null; }
self_version() { sed -n 's/^SPORK_VERSION=//p' "$1/spork" | head -1; }
self_sum() { shasum "$SELF_DIR/spork" 2>/dev/null | cut -d' ' -f1; }

# Put $1 in place of $SELF_DIR. Moving and deleting files is safe even while
# one of them runs: bash keeps reading the old file it already opened.
self_swap() {
  rm -rf "$SELF_DIR.old"
  if [ -e "$SELF_DIR" ] || [ -L "$SELF_DIR" ]; then mv "$SELF_DIR" "$SELF_DIR.old" || return 1; fi
  mv "$1" "$SELF_DIR" || { mv "$SELF_DIR.old" "$SELF_DIR"; return 1; }
  rm -rf "$SELF_DIR.old"
  ln -sfn "$SELF_DIR/spork" "$BIN_DIR/spork"
}

# Used by install.sh: fetch a fresh copy of spork into $SELF_DIR.
cmd_self_install() {
  local new=$SPORK_HOME/self.new
  rm -rf "$new"; mkdir -p "$BIN_DIR"
  if has_git; then netgit clone -q --depth 1 "$SPORK_REPO" "$new"
  else ( fetch_drawer_tarball "$SPORK_REPO" "$new" ); fi \
    && self_valid "$new" && self_swap "$new" && return 0
  rm -rf "$new"; return 1
}

# Update spork itself. If the running spork is the installed one and it changed,
# run "spork update" again with the new version, which then skips this step.
self_update() {
  local running= before head new
  [ -z "$SPORK_NO_SELF_UPDATE" ] && [ -z "$SPORK_SELF_UPDATED" ] || return 0
  [ -d "$SELF_DIR" ] && [ ! -L "$SELF_DIR" ] || return 0
  [ "$0" -ef "$SELF_DIR/spork" ] && running=1
  before=$(self_sum)
  if [ -d "$SELF_DIR/.git" ]; then
    has_git || { warn "can't update spork: git is not available"; return 0; }
    note "updating spork"
    head=$(git -C "$SELF_DIR" rev-parse HEAD) || { warn "could not update spork"; return 0; }
    netgit -C "$SELF_DIR" pull --ff-only -q || { warn "could not update spork"; return 0; }
    if ! self_valid "$SELF_DIR"; then
      git -C "$SELF_DIR" reset -q --hard "$head"
      warn "the new version of spork looks broken; keeping the current one"; return 0
    fi
  elif [ -f "$SELF_DIR/.spork-source" ]; then
    note "updating spork"
    new=$TMP_ROOT/self
    ( fetch_drawer_tarball "$(cat "$SELF_DIR/.spork-source")" "$new" ) || { warn "could not update spork"; return 0; }
    if ! self_valid "$new"; then warn "the new version of spork looks broken; keeping the current one"; return 0; fi
    [ "$(shasum "$new/spork" | cut -d' ' -f1)" = "$before" ] && return 0
    self_swap "$new" || { warn "could not update spork"; return 0; }
  else
    return 0
  fi
  [ "$(self_sum)" != "$before" ] || return 0
  say "Updated spork to $(self_version "$SELF_DIR")"
  if [ -n "$running" ]; then
    cleanup                               # exec skips the EXIT trap
    export SPORK_SELF_UPDATED=1
    exec "$SELF_DIR/spork" update
  fi
}

# ---------------------------------------------------------------- commands

cmd_install() {
  local q failed=0
  [ $# -gt 0 ] || die "usage: spork install <package>..."
  for q in "$@"; do ( do_install "$q" ) || failed=1; done
  path_hint
  return $failed
}

cmd_uninstall() {
  local q failed=0
  [ $# -gt 0 ] || die "usage: spork uninstall <package>..."
  for q in "$@"; do ( do_uninstall "$q" ) || failed=1; done
  return $failed
}

cmd_update() {
  local name cur new failed=0 all=
  if [ $# -eq 0 ]; then
    self_update
    say "Updating drawers"
    update_drawers $(list_drawers)
    cmd_status; return 0
  fi
  if [ "$1" = --all ] || [ "$1" = '*' ]; then all=1; set -- $(installed_list); fi
  for name in "$@"; do
    cur=$(installed_version "$name") || { warn "$name is not installed"; failed=1; continue; }
    if [ -f "$APPS_DIR/$name/.hold" ]; then note "$name is held at $cur; skipping"; continue; fi
    new=$(latest_version "$name")
    if [ -z "$new" ]; then warn "$name: no manifest found any more"; continue; fi
    if [ "$new" = "$cur" ] && [ -z "$FORCE" ]; then
      [ -z "$all" ] && say "$name $cur is up to date"; continue
    fi
    ( do_install "$(source_of "$name")" ) || failed=1
  done
  [ -n "$all" ] && [ $failed -eq 0 ] && say "Everything is up to date"
  return $failed
}

cmd_status() {
  local name cur new outdated=0
  for name in $(installed_list); do
    cur=$(installed_version "$name"); new=$(latest_version "$name")
    if [ -n "$new" ] && [ "$new" != "$cur" ]; then
      [ $outdated -eq 0 ] && say "Updates available:"
      printf '    %-24s %s -> %s%s\n' "$name" "$cur" "$G$new$N" "$([ -f "$APPS_DIR/$name/.hold" ] && echo " (held)")"
      outdated=$((outdated + 1))
    fi
  done
  if [ $outdated -eq 0 ]; then say "Everything is up to date"; else note "run 'spork update --all' to update"; fi
}

cmd_list() {
  local name any=
  for name in $(installed_list); do
    [ -z "$any" ] && printf '%s%-24s %-16s %s%s\n' "$B" Name Version Drawer "$N" && any=1
    printf '%-24s %-16s %s%s\n' "$name" "$(installed_version "$name")" "$(receipt "$name" drawer)" \
      "$([ -f "$APPS_DIR/$name/.hold" ] && echo " (held)")"
  done
  [ -n "$any" ] || say "Nothing installed yet. Try: spork search"
}

cmd_search() {
  local q=$1 b d f name hits found=
  for b in $(list_drawers); do
    d=$(manifest_dir "$DRAWERS_DIR/$b")
    # Match on file name first, then on file contents (cheap), then read only the hits.
    if [ -n "$q" ]; then
      hits=$( { ls "$d" | grep '\.json$' | sed 's/\.json$//' | grep -i -- "$q" | sed "s|.*|$d/&.json|"
                grep -il -- "\"description\".*$q" "$d"/*.json 2>/dev/null; } | sort -u)
    else
      hits=$(ls "$d"/*.json 2>/dev/null)
    fi
    [ -n "$hits" ] || continue
    printf '%s%s drawer:%s\n' "$C" "$b" "$N"; found=1
    while IFS= read -r f; do
      name=$(basename "$f" .json)
      printf '    %s%-22s%s %-12s %s\n' "$B" "$name" "$N" "$(jget "$f" version)" "$(jget "$f" description)"
    done <<EOF
$hits
EOF
  done
  [ -n "$found" ] || say "No packages found${q:+ matching '$q'}"
}

cmd_info() {
  [ $# -eq 1 ] || die "usage: spork info <package>"
  resolve "$1"
  local f=$M_FILE cur v
  if jhas "$f" "architecture.$ARCH"; then M_ARCH=$ARCH; else M_ARCH=universal; fi
  printf '%sName:%s        %s\n' "$B" "$N" "$M_NAME"
  for v in description version homepage license; do
    jhas "$f" "$v" && printf '%s%-12s%s %s\n' "$B" "$(echo "$v" | awk '{print toupper(substr($0,1,1)) substr($0,2)}'):" "$N" "$(jget "$f" "$v")"
  done
  printf '%sDrawer:%s      %s\n' "$B" "$N" "$M_DRAWER"
  cur=$(installed_version "$M_NAME")
  printf '%sInstalled:%s   %s\n' "$B" "$N" "${cur:-no}"
  v=$(bin_entries "$f" | cut -f2 | tr '\n' ' '); [ -n "${v% }" ] && printf '%sCommands:%s    %s\n' "$B" "$N" "$v"
  v=$(k=$(mkey "$f" app) && jlist "$f" "$k" | tr '\n' ' '); [ -n "${v% }" ] && printf '%sApps:%s        %s\n' "$B" "$N" "$v"
  v=$(k=$(mkey "$f" font) && jlist "$f" "$k" | tr '\n' ' '); [ -n "${v% }" ] && printf '%sFonts:%s       %s\n' "$B" "$N" "$v"
  v=$(jlist "$f" depends | tr '\n' ' '); [ -n "${v% }" ] && printf '%sDepends:%s     %s\n' "$B" "$N" "$v"
  [ -d "$PERSIST_DIR/$M_NAME" ] && printf '%sSaved data:%s  %s\n' "$B" "$N" "$PERSIST_DIR/$M_NAME"
  v=$(resolve_paths "$M_NAME" "$f" 2>/dev/null | tr '\n' ' '); [ -n "${v% }" ] && printf '%sAdds to PATH:%s %s\n' "$B" "$N" "$v"
  return 0
}

cmd_drawer() {
  local sub=$1; shift
  case $sub in
    add)
      local name=$1 url=$2 d
      [ -n "$url" ] || url=$(known_drawer_url "$name") \
        || die "usage: spork drawer add <name> <git-url | github-url | directory>  (main, apps and fonts need no URL)"
      d=$DRAWERS_DIR/$name
      [ -e "$d" ] && die "drawer '$name' already exists"
      mkdir -p "$DRAWERS_DIR"
      if [ -d "$url" ]; then
        ln -s "$(cd "$url" && pwd)" "$d"
      elif has_git; then
        netgit clone -q --depth 1 "$url" "$d" \
          || die "could not clone $url"
      else
        fetch_drawer_tarball "$url" "$d"
      fi
      say "Added drawer '$name' ($(ls "$(manifest_dir "$d")"/*.json 2>/dev/null | wc -l | tr -d ' ') packages)" ;;
    rm|remove)
      [ -n "$1" ] || die "usage: spork drawer rm <name>"
      [ -e "$DRAWERS_DIR/$1" ] || die "no drawer named '$1'"
      rm -rf "$DRAWERS_DIR/$1"; say "Removed drawer '$1'" ;;
    list|ls|'')
      local b
      for b in $(list_drawers); do
        printf '%s%-12s%s %4s packages  %s%s%s\n' "$B" "$b" "$N" \
          "$(ls "$(manifest_dir "$DRAWERS_DIR/$b")"/*.json 2>/dev/null | wc -l | tr -d ' ')" "$D" "$(drawer_kind "$b")" "$N"
      done ;;
    update)
      update_drawers ${@:-$(list_drawers)} ;;
    *) die "usage: spork drawer [add|rm|list|update]" ;;
  esac
}

# Cleanup removes things spork no longer uses: cached downloads (including
# half-finished .part files) and version folders that "current" doesn't point
# to, left behind when an install or update failed partway. Commands link
# through "current" and .app bundles are moved out to $SPORK_APPDIR, so
# nothing else refers to those folders. The helpers add to the CLEAN_* counts.

clean_reset() { CLEAN_FILES=0 CLEAN_VERSIONS=0 CLEAN_KB=0; }

clean_rm() {
  CLEAN_KB=$((CLEAN_KB + $(du -sk "$1" 2>/dev/null | cut -f1)))
  rm -rf "$1"
}

clean_report() {
  local parts=() freed=$CLEAN_KB
  [ "$CLEAN_VERSIONS" -gt 0 ] && parts+=("$CLEAN_VERSIONS old version(s)")
  [ "$CLEAN_FILES" -gt 0 ] && parts+=("$CLEAN_FILES cached file(s)")
  [ ${#parts[@]} -gt 0 ] || { say "Nothing to clean up"; return 0; }
  if [ "$freed" -ge 1024 ]; then freed="$(awk "BEGIN{printf \"%.1f\", $freed/1024}") MB"
  else freed="$freed KB"; fi
  if [ ${#parts[@]} -eq 2 ]; then say "Removed ${parts[0]} and ${parts[1]}, freed $freed"
  else say "Removed ${parts[0]}, freed $freed"; fi
}

check_pkg_names() {
  local p; for p in "$@"; do
    case $p in ''|.*|*/*) die "invalid package name '$p'" ;; esac
  done
}

# Cached downloads of the given packages, or all of them.
clean_cache() {
  local pats=() p f
  if [ $# -eq 0 ]; then pats=('*'); else for p in "$@"; do pats+=("$p#*"); done; fi
  [ -d "$CACHE_DIR" ] || return 0
  for p in "${pats[@]}"; do
    while IFS= read -r f; do
      [ -n "$f" ] && clean_rm "$f" && CLEAN_FILES=$((CLEAN_FILES + 1))
    done <<EOF
$(find "$CACHE_DIR" -mindepth 1 -maxdepth 1 -name "$p")
EOF
  done
}

# Version folders of the given packages (or all) that "current" doesn't point to.
clean_versions() {
  local name pkgdir cur v
  if [ $# -eq 0 ]; then set -- $(ls "$APPS_DIR" 2>/dev/null); fi
  for name in "$@"; do
    pkgdir=$APPS_DIR/$name
    [ -d "$pkgdir" ] && [ ! -L "$pkgdir" ] || continue
    cur=$(installed_version "$name")
    for v in "$pkgdir"/*; do
      [ -d "$v" ] && [ ! -L "$v" ] && [ "${v##*/}" != "$cur" ] || continue
      clean_rm "$v"; CLEAN_VERSIONS=$((CLEAN_VERSIONS + 1))
      note "removed $name ${v##*/}"
    done
    rmdir "$pkgdir" 2>/dev/null           # a failed first install can leave it empty
  done
}

cmd_cleanup() {
  [ "$1" = --all ] && shift
  check_pkg_names "$@"
  clean_reset; clean_versions "$@"; clean_cache "$@"; clean_report
}

cmd_cache() {
  case $1 in
    rm|clear)
      shift; [ "$1" = --all ] && shift
      check_pkg_names "$@"; clean_reset; clean_cache "$@"; clean_report ;;
    show|'')
      [ -d "$CACHE_DIR" ] && [ -n "$(ls "$CACHE_DIR")" ] || { say "Cache is empty"; return 0; }
      ls "$CACHE_DIR" | sed 's/^/    /'
      say "Total: $(du -sh "$CACHE_DIR" | cut -f1)  (spork cleanup [package] to clear)" ;;
    *) die "usage: spork cache [show|rm [package...]]" ;;
  esac
}

cmd_hold() {
  local n; for n in "$@"; do
    [ -d "$APPS_DIR/$n" ] || die "$n is not installed"
    if [ "$HOLD" = 1 ]; then touch "$APPS_DIR/$n/.hold"; say "$n will not be updated"
    else rm -f "$APPS_DIR/$n/.hold"; say "$n can be updated again"; fi
  done
}

cmd_mirror() {
  local sub=$1; shift
  case $sub in
    add)
      local from=$1 to=$2
      [ -n "$from" ] && [ -n "$to" ] && [ $# -eq 2 ] || die "usage: spork mirror add <from-prefix> <to-prefix>"
      case "$from$to" in *[[:space:]]*) die "URL prefixes can't contain spaces";; esac
      mkdir -p "$(dirname "$MIRRORS_FILE")"
      mirror_remove "$from"
      printf '%s %s\n' "$from" "$to" >> "$MIRRORS_FILE"
      say "Downloads from $from now go to $to" ;;
    rm|remove)
      [ -n "$1" ] || die "usage: spork mirror rm <from-prefix>"
      mirror_rules | cut -f1 | grep -qxF -- "$1" || die "no mirror rule for $1"
      mirror_remove "$1"; say "Removed the mirror rule for $1" ;;
    list|ls|'')
      local from to any= acct
      while IFS=$'\t' read -r from to; do
        [ -n "$from" ] || continue
        printf '%s\n    %s-> %s%s\n' "$from" "$D" "$N" "$to"; any=1
        acct=$(keychain_account "$(url_host "$to")") && note "   login: $acct (from the keychain)"
      done <<EOF
$(mirror_rules)
EOF
      [ -n "$any" ] || say "No mirror rules. Add one with: spork mirror add <from-prefix> <to-prefix>"
      [ -n "$any" ] && note "rules are read from $MIRRORS_FILE" ;;
    test)
      [ -n "$1" ] || die "usage: spork mirror test <url>"
      mirror_url "$1" ;;
    *) die "usage: spork mirror [add <from> <to> | rm <from> | list | test <url>]" ;;
  esac
}

# Drop the rule for one prefix, keeping comments and other rules as they are.
mirror_remove() {
  [ -f "$MIRRORS_FILE" ] || return 0
  awk -v f="$1" '$1 != f' "$MIRRORS_FILE" > "$MIRRORS_FILE.tmp" && mv "$MIRRORS_FILE.tmp" "$MIRRORS_FILE"
}

cmd_hash() {
  [ -n "$1" ] || die "usage: spork hash <file | url>"
  local f=$1
  case $1 in http*) f=$TMP_ROOT/hash-download; mcurl -fL --progress-bar -o "$f" "$1" || die "download failed: $(mirror_url "$1")";; esac
  echo "sha256:$(shasum -a 256 "$f" | awk '{ print $1 }')"
}

cmd_which() {
  [ -n "$1" ] || die "usage: spork which <command>"
  local l=$BIN_DIR/$1 o
  [ -L "$l" ] || die "'$1' is not a spork command"
  o=$(owner_of .spork-bins "$1")
  echo "$(readlink "$l")${o:+  ($o)}"
}

# PATH gets $BIN_DIR first, then the folders installed packages asked for
# with "env_add_path".
cmd_shellenv() {
  local dirs=$BIN_DIR name p
  for name in $(installed_list); do
    [ -f "$APPS_DIR/$name/.spork-paths" ] || continue
    while IFS= read -r p; do
      [ -n "$p" ] && dirs="$dirs:$p"
    done < "$APPS_DIR/$name/.spork-paths"
  done
  case ${SHELL##*/} in
    fish) echo "fish_add_path -g $(printf '%s\n' "$dirs" | tr ':' '\n' | sed 's/.*/"&"/' | tr '\n' ' ')" ;;
    *)    echo "export PATH=\"$dirs:\$PATH\"" ;;
  esac
}

path_hint() {
  case ":$PATH:" in *":$BIN_DIR:"*) ;; *)
    warn "$BIN_DIR is not on your PATH. Add this line to ~/.zshrc:
    eval \"\$($BIN_DIR/spork shellenv)\"" ;;
  esac
}

cmd_doctor() {
  local ok=1
  case ":$PATH:" in *":$BIN_DIR:"*) say "PATH includes $BIN_DIR" ;; *) ok=; path_hint ;; esac
  if mkdir -p "$SPORK_APPDIR" 2>/dev/null && [ -w "$SPORK_APPDIR" ]; then say "$SPORK_APPDIR is writable"
  else ok=; warn "$SPORK_APPDIR is not writable"; fi
  if mkdir -p "$SPORK_FONTDIR" 2>/dev/null && [ -w "$SPORK_FONTDIR" ]; then say "$SPORK_FONTDIR is writable"
  else ok=; warn "$SPORK_FONTDIR is not writable"; fi
  if [ -n "$(list_drawers)" ]; then say "Drawers: $(list_drawers | tr '\n' ' ')"
  else ok=; warn "no drawers. Add the official ones with: spork drawer add main; spork drawer add apps"; fi
  local m; m=$(mirror_rules | grep -c .)
  [ "$m" -gt 0 ] && say "$m mirror rule(s) in $MIRRORS_FILE"
  local h acct
  for h in $(mirror_rules | cut -f2 | while IFS= read -r t; do url_host "$t"; done | sort -u); do
    acct=$(keychain_account "$h") && say "Mirror $h: logging in as $acct (from the keychain)"
  done
  if [ -L "$SELF_DIR" ]; then note "spork is linked to $(readlink "$SELF_DIR") and won't update itself"
  elif [ -d "$SELF_DIR/.git" ]; then say "spork updates itself from $(git -C "$SELF_DIR" remote get-url origin 2>/dev/null)"
  elif [ -f "$SELF_DIR/.spork-source" ]; then say "spork updates itself from $(cat "$SELF_DIR/.spork-source")"
  else note "spork can't update itself; run install.sh again to fix that"; fi
  if has_git; then say "git is available"
  else note "git not found: drawers will be downloaded as archives (GitHub only)"; fi
  [ "$ARCH" = arm64 ] && ! /usr/bin/pgrep -q oahd && note "Rosetta 2 is not running; Intel-only packages won't start"
  [ -n "$ok" ] && say "All good"
}

usage() {
  cat <<EOF
${B}spork $SPORK_VERSION${N} - install apps and tools on macOS without admin rights

${B}Usage:${N} spork <command> [options] [args]

  install <pkg>...      Install packages (name, drawer/name, ./file.json or URL)
  uninstall <pkg>...    Remove packages and their apps/fonts/commands (--purge also
                        deletes their saved data)
  update                Update spork and drawers, show new packages and updates
  update <pkg>...       Update packages (--all for everything)
  status                Show packages with updates available
  list                  List installed packages
  search [query]        Search drawers
  info <pkg>            Show package details
  cat <pkg>             Print a package's manifest
  home <pkg>            Open a package's homepage
  prefix <pkg>          Print a package's install directory
  which <command>       Show where a command comes from
  hold | unhold <pkg>   Stop / allow updates for a package
  drawer add <name> [url|dir] | rm <name> | list | update
  cleanup [pkg...]      Delete cached downloads and leftover old versions
                        (of all packages, or just these)
  cache [show | rm [pkg...]]
  mirror add <from> <to> | rm <from> | list | test <url>
                        Rewrite download URLs to go through a proxy or mirror
  hash <file|url>       Print a sha256 for writing manifests
  shellenv              Print the line that adds spork to PATH
  doctor                Check your setup

${B}Options:${N} -f, --force   reinstall, or replace files spork doesn't own

Apps go to $SPORK_APPDIR, fonts to $SPORK_FONTDIR, commands to $BIN_DIR.
EOF
}

# ---------------------------------------------------------------- main

args=()
for a in "$@"; do
  case $a in
    -f|--force) FORCE=1 ;;
    --purge) PURGE=1 ;;
    -h|--help) [ ${#args[@]} -eq 0 ] && { usage; exit 0; }; args+=("$a") ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]}"

cmd=$1; [ $# -gt 0 ] && shift
case $cmd in
  install|i)      cmd_install "$@" ;;
  uninstall|rm|remove) cmd_uninstall "$@" ;;
  update|up|upgrade) cmd_update "$@" ;;
  status)         cmd_status ;;
  list|ls)        cmd_list ;;
  search|s)       cmd_search "$1" ;;
  info)           cmd_info "$@" ;;
  cat)            resolve "$1"; cat "$M_FILE" ;;
  home)           resolve "$1"; open "$(jget "$M_FILE" homepage)" ;;
  prefix)         [ -n "$(installed_version "$1")" ] || die "$1 is not installed"; echo "$APPS_DIR/$1/current" ;;
  which)          cmd_which "$1" ;;
  hold)           HOLD=1 cmd_hold "$@" ;;
  unhold)         HOLD=0 cmd_hold "$@" ;;
  drawer)         cmd_drawer "$@" ;;
  cache)          cmd_cache "$@" ;;
  cleanup)        cmd_cleanup "$@" ;;
  hash)           cmd_hash "$1" ;;
  mirror|mirrors) cmd_mirror "$@" ;;
  shellenv)       cmd_shellenv ;;
  doctor)         cmd_doctor ;;
  _self-install)  cmd_self_install ;;
  version|--version|-v) echo "spork $SPORK_VERSION" ;;
  help|'')        usage ;;
  *)              die "unknown command '$cmd' (see: spork help)" ;;
esac
